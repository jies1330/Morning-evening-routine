rules_version = '2';

// Règles de sécurité de Pépin.
// Chaque famille est un document families/{code} qui liste ses membres (parents).
// Seuls les membres peuvent lire et modifier les routines, enfants, étoiles…
// Pour rejoindre une famille, il faut connaître son code (12 caractères).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMember(fid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // Petite fiche par parent : le code de sa famille.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Créer une famille : on en est le seul membre au départ.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members == [request.auth.uid];

      // Un membre peut tout modifier ; un nouveau parent peut seulement s'ajouter à la liste.
      allow update: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 10
        && (request.auth.uid in resource.data.members
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members));

      allow delete: if false;

      // Routines, enfants, récompenses, étoiles, réglages : membres uniquement.
      match /{col}/{docId} {
        allow read, write: if isMember(fid);
      }
    }
  }
}
